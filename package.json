{
  "name": "prometheus",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "lint": "npm run lint --workspace=web",
    "typecheck": "npm run typecheck --workspace=web && npm run typecheck --workspace=@prometheus/database",
    "test": "npm run test --workspace=web && npm run test --workspace=@prometheus/database",
    "db:generate": "npm run db:generate --workspace=@prometheus/database",
    "db:migrate": "npm run db:migrate --workspace=@prometheus/database",
    "db:test": "npm run db:test --workspace=@prometheus/database"
  }
}
