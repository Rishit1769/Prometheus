{
  "name": "prometheus",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck && pnpm --filter @prometheus/database typecheck",
    "test": "pnpm --filter web test && pnpm --filter @prometheus/database test",
    "db:generate": "pnpm --filter @prometheus/database db:generate",
    "db:migrate": "pnpm --filter @prometheus/database db:migrate",
    "db:test": "pnpm --filter @prometheus/database db:test"
  }
}
