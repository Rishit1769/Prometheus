  },
  "devDependencies": {
    "@types/node": "24.8.0",
    "@types/pg": "8.15.5",
    "prisma": "7.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
