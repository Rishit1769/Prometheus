# PROMETHEUS environment configuration
#
# Copy this file to `.env` and fill in values. Never commit real secrets.
# Status: Proposed — no application reads these variables yet. Names and
# required values will be finalized as implementation begins.

# ---------------------------------------------------------------------------
# Core application
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (PostgreSQL + pgvector)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://prometheus:prometheus@localhost:5432/prometheus?schema=public
POSTGRES_USER=prometheus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=prometheus
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis (cache / async infrastructure)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Object / artifact storage (MinIO, S3-compatible)
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=prometheus-artifacts
MINIO_USE_SSL=false

# ---------------------------------------------------------------------------
# GitHub OAuth / API
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/callback/github
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AI / ML service (FastAPI)
# ---------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=

# ---------------------------------------------------------------------------
# Model provider credentials (server-side only; never exposed to agents)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Benchmark sandbox
# ---------------------------------------------------------------------------
SANDBOX_DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT_MB=2048
SANDBOX_TIMEOUT_SECONDS=900
SANDBOX_NETWORK_DISABLED=true

# ---------------------------------------------------------------------------
# Auth / session
# ---------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me
